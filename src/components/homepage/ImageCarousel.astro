---
import { getCarouselImageUrl, getCarouselSrcSet } from "../../sanity/lib/images";
// loading: "lazy" lets a page include the carousel in markup it hides at some
// widths (the design preview) without downloading the images there.
const { images = [], loading = "eager" } = Astro.props; // Default to empty array

---
<div class="carousel-bg">
  {images.length > 0 && (
    images.map((image: { asset: any }, index: number) => {
      // the whole image, not just its asset, so an editor's hotspot/crop applies
      const src = getCarouselImageUrl(image); // default 1600x500
      const srcSet = getCarouselSrcSet(image); // up to 1920x500

      return (
        <img
          class={`carousel-image ${index === 0 ? "active" : ""}`}
          src={src}
          srcset={srcSet}
          sizes="100vw"
          alt={`Guild work ${index + 1}`}
          loading={loading}
        />
      );
    })
  )}
</div>

<style lang="scss">
  @use "../../styles/_breakpoints.scss" as *;

.carousel-bg {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  z-index: 0;
  overflow: hidden;
}

/* Default (mobile-first) */
.carousel-image {
  position: absolute;
  width: 100%;
  height: 100%;
  opacity: 0;
  transition: opacity 1s ease-in-out;
  object-fit: cover;
  object-position: center 25%; /* show more top on mobile */
  @media (min-width: $BREAKPOINT_TABLET_PORTRAIT) {
    object-position: center center;
  }
}

.carousel-image.active {
  opacity: 1;
  z-index: 1;
}

</style>

<script is:inline>
  (() => {
    const images = document.querySelectorAll(".carousel-image");
    const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    if (images.length < 2 || reduceMotion) return;

    let current = 0;
    const TIME_INTERVAL_BETWEEN_TRANSITIONS = 4000;

    setInterval(() => {
      images[current].classList.remove("active");
      current = (current + 1) % images.length;
      images[current].classList.add("active");
    }, TIME_INTERVAL_BETWEEN_TRANSITIONS);
  })();
</script>
