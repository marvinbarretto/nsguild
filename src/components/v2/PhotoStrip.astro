---
// Design-preview component: a still strip of four photos under the nav
// (it replaced a drifting ribbon the client found distracting). The photos
// are picked in the Studio (Homepage → Photo Strip); with fewer than four
// picked, the newest gallery photos fill the gaps.
//
// Picked photos are cropped to 3:2 server-side so the editor's hotspot is
// honoured; the cell then covers whatever shape the viewport gives it.
// Four across. On the design preview it is only shown from $BREAKPOINT_SMALL
// up; phones get the homepage carousel instead.
//
// The zigzag edge comes from PinkedEdge.
import PinkedEdge from "./PinkedEdge.astro";
import { imageBuilderFor } from "../../sanity/lib/images";
import type { GalleryImage, StripImage } from "../../utils/types";

export interface Props {
  picked?: StripImage[];
  fallback?: GalleryImage[];
}

const { picked = [], fallback = [] }: Props = Astro.props;

const WIDTHS = [400, 600, 800, 1200];
const cropped = (img: StripImage, w: number) =>
  imageBuilderFor(img as any).width(w).height(Math.round((w * 2) / 3)).fit("crop").auto("format").url();

const tiles = [
  ...picked
    .filter((img) => img?.asset?._id)
    .map((img) => ({
      src: cropped(img, 800),
      srcset: WIDTHS.map((w) => `${cropped(img, w)} ${w}w`).join(", "),
      alt: img.alt ?? "",
    })),
  ...fallback.map((img) => ({
    src: img.thumb2x,
    srcset: `${img.thumb} 400w, ${img.thumb2x} 800w`,
    alt: "",
  })),
].slice(0, 4);
---

{tiles.length > 0 && (
  <PinkedEdge href="/gallery" label="Browse the photo gallery">
    <ul class="strip" role="list">
      {tiles.map((t) => (
        <li>
          <img
            src={t.src}
            srcset={t.srcset}
            sizes="25vw"
            alt={t.alt}
            loading="lazy"
          />
        </li>
      ))}
    </ul>
  </PinkedEdge>
)}

<style lang="scss">
  .strip {
    --strip-gap: 5px;
    --strip-max-height: 300px; /* caps the row on wide screens */

    display: grid;
    gap: var(--strip-gap);
    list-style: none;
    margin: 0;
    padding: 0;
    grid-template-columns: repeat(4, 1fr);
  }

  .strip img {
    display: block;
    width: 100%;
    aspect-ratio: 3 / 2;
    max-height: var(--strip-max-height);
    object-fit: cover;
  }
</style>
