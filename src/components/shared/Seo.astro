---
// Head extras: meta description + LCP preload. The document <title> is owned
// by BaseLayout — emitting one here too gave every page two title elements.
const { description, preloadImage } = Astro.props as any;
---

{description && <meta name="description" content={description} />}

{preloadImage && (
  <link
    rel="preload"
    as="image"
    href={preloadImage.url}
    imagesrcset={preloadImage.srcSet}
    imagesizes={preloadImage.sizes || "100vw"}
    type={preloadImage.type}
  />
)}
