---
import PortableText from "./PortableText.astro";
import DateDisplay from "./DateDisplay.astro";
import { imageBuilderFor } from "../../sanity/lib/images.ts";

const { date, dateVariant, title, variant, body, moreDetail, badge, description, mainImage, relatedGallery} = Astro.props;
---

{mainImage && mainImage.asset && (
  <img 
    src={imageBuilderFor(mainImage.asset).width(600).auto('format').url()} 
    alt={mainImage.alt || title}
    class="list-item__image"
  />
)}

{date && <DateDisplay date={date} variant={dateVariant} />}
<div class="list-item__content">
  <div class="list-item__text">
    {badge && <span class="list-item__badge">{badge}</span>}
    <h3 class="list-item__title">{title}</h3>

    {variant === "news-full" && body ? (
      <div class="list-item__body">
        <PortableText portableText={body} />
        {moreDetail && <PortableText portableText={moreDetail} />}
      </div>
    ) : (
      description && <p class="snippet">{description}</p>
    )}

    {relatedGallery && (
    <a href={`/gallery/albums/${relatedGallery.slug}`} class="gallery-link">
      View Gallery of {relatedGallery.title}
    </a>
    )}
  </div>
</div>

<style lang="scss">
  .list-item__content {
      display: flex;
      gap: 1rem;
      align-items: flex-start;
      flex-direction: column;
    }


    .list-item__text {
      flex: 1;
      display: flex;
      flex-direction: column;
      justify-content: center;
      gap: 1rem;
    }

    .list-item__badge {
      align-self: flex-start;
      padding: 0.1rem 0.6rem;
      border: 2px dashed #a63a00;
      border-radius: 999px;
      color: #a63a00;
      font-size: 0.8rem;
      font-weight: 700;
    }

    .snippet {
      max-width: 72ch;
    }

    .list-item__title {
      font-size: 1.5rem;
    }

    @media (max-width: 768px) {


    }
  </style>