---
// Design preview of the News page: the live /news, plus unpublished drafts so
// the client can approve a post before it is published. The preview
// homepage's "Read more" links land here. Noindexed and unlinked.
import { fetchNewsWithDrafts } from '../../sanity/queries/news';
import { getCachedGlobals } from '../../utils/cache';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ListItem from "../../components/shared/ListItem.astro";
import PageTitle from "../../components/shared/PageTitle.astro";
import PageDescription from "../../components/shared/PageDescription.astro";
import PortableText from '../../components/shared/PortableText.astro';

const [posts, globals] = await Promise.all([fetchNewsWithDrafts(12), getCachedGlobals()]);
const newsDescription = globals?.pagesContent?.newsPageDescription;
---

<BaseLayout title="News (design preview)" noindex>
  <div class="container">

    <PageTitle title="News" />
    {newsDescription && <PageDescription>
      <PortableText portableText={newsDescription}></PortableText>
    </PageDescription>}

    <ul class="news">
      {posts.map((post) => (
        <ListItem
          title={post.title}
          date={post.publishedAt}
          body={post.body}
          moreDetail={post.moreDetail}
          id={post.slug}
          mainImage={post.mainImage}
          basePath="/news"
          variant="news-full"
          linkThroughToPage={false}
        />
      ))}
    </ul>
  </div>
</BaseLayout>

<style>
  .news {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    margin: 1rem auto;
    max-width: 72ch;
  }
</style>
