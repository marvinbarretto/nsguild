---
// Design preview: proposed homepage layout, side by side with the live site.
// Not linked from navigation, noindexed, and absent from the sitemap allowlist.
// All content is real CMS data — nothing here assumes fields that don't exist.
//
// Round two (client feedback, mockups/2026-10-14-feedback.md): a still photo
// strip picked in the Studio, the next event leads Coming up, and news shows
// each post's leader with a link through for the detail.
//
// News here, and on /preview/news where "Read more" leads, includes unpublished
// drafts so the client can approve a post before it goes live.
// This needs SANITY_PREVIEW_TOKEN (see fetchNewsWithDrafts); without it only
// published posts show.
//
// All design tokens live in the `.v2` block at the top of the styles below —
// tweak there.
import BaseLayout from "../../layouts/BaseLayout.astro";
import PortableText from "../../components/shared/PortableText.astro";
import DateDisplay from "../../components/shared/DateDisplay.astro";
import PhotoStrip from "../../components/v2/PhotoStrip.astro";
import { fetchHomepageData } from "../../sanity/queries/homepage-consolidated";
import { fetchAllEvents } from "../../sanity/queries/event";
import { fetchNewsWithDrafts } from "../../sanity/queries/news";
import { getAllGalleryImages } from "../../sanity/queries/gallery";

const [{ homepage, nextEvent }, allEvents, newsPosts] = await Promise.all([
  fetchHomepageData(),
  fetchAllEvents(),
  fetchNewsWithDrafts(3),
]);

// Top up the strip from the newest gallery photos when fewer than four are picked.
const pickedStrip = (homepage.stripImages ?? []).slice(0, 4);
const stripFallback =
  pickedStrip.length < 4 ? await getAllGalleryImages({ limit: 4 - pickedStrip.length }) : [];

const today = new Date().toISOString().split("T")[0];
const upcomingEvents = allEvents
  .filter((e) => e.date >= today && e.slug !== nextEvent?.slug)
  .slice(0, 4);

const chip = (iso: string) => {
  const d = new Date(iso);
  return {
    wd: d.toLocaleString("en-GB", { weekday: "short" }),
    day: d.getDate(),
    mon: d.toLocaleString("en-GB", { month: "short" }),
  };
};

const staticSections = [
  { id: "about", heading: "About the Guild", body: homepage.whoWeAre, wide: true },
  { id: "what-we-do", heading: "What we do", body: homepage.whatWeDo, wide: false },
  { id: "when-we-meet", heading: "When we meet", body: homepage.whenWeMeet, wide: false },
  { id: "where-we-meet", heading: "Where we meet", body: homepage.whereWeMeet, wide: true },
].filter((s) => s.body);
---

<BaseLayout title="Design preview" noindex>
  <div class="v2">
    <PhotoStrip picked={pickedStrip} fallback={stripFallback} />

    <div class="container">
      <nav class="quick-links" aria-label="About the Guild">
        {staticSections.map((s) => <a href={`#${s.id}`}>{s.heading}</a>)}
      </nav>

      <div class="columns">
        {newsPosts && newsPosts.length > 0 && (
          <section class="panel" aria-labelledby="news-title">
            <h2 class="section-head" id="news-title">Latest news</h2>
            {newsPosts.map((post) => (
              <article class="news-item">
                <DateDisplay date={post.publishedAt} />
                <h3>{post.title}</h3>
                <PortableText portableText={post.body} />
                {post.hasMoreDetail && (
                  <a class="read-more" href={`/preview/news#${post.slug}`}>
                    Read more<span class="visually-hidden"> about {post.title}</span> →
                  </a>
                )}
              </article>
            ))}
            <a class="all-link" href="/preview/news">All news →</a>
          </section>
        )}

        <div class="side-col">
          {(nextEvent || upcomingEvents.length > 0) && (
            <section class="panel" aria-labelledby="coming-up-title">
              <h2 class="section-head" id="coming-up-title">Coming up</h2>
              {nextEvent && (
                <div class="event-row">
                  <div class="mini-cal" aria-hidden="true">
                    <span class="mini-cal__wd">{chip(nextEvent.date).wd}</span>
                    <span class="mini-cal__day">{chip(nextEvent.date).day}</span>
                    <span class="mini-cal__mon">{chip(nextEvent.date).mon}</span>
                  </div>
                  <div class="event-row__body">
                    <h3>{nextEvent.title}</h3>
                    <PortableText portableText={nextEvent.description} />
                  </div>
                </div>
              )}
              {upcomingEvents.map((event) => {
                const c = chip(event.date);
                return (
                  <div class="event-row">
                    <div class="mini-cal" aria-hidden="true">
                      <span class="mini-cal__wd">{c.wd}</span>
                      <span class="mini-cal__day">{c.day}</span>
                      <span class="mini-cal__mon">{c.mon}</span>
                    </div>
                    <div class="event-row__body">
                      <h3>{event.title}</h3>
                      <PortableText portableText={event.description} />
                    </div>
                  </div>
                );
              })}
              <a class="all-link" href="/events">Full programme →</a>
            </section>
          )}

          {/* "New here?" visitor card — parked (not in the client's brief) but may return.
          <section class="panel visit-card" aria-labelledby="visit-title">
            <h2 class="section-head" id="visit-title">New here?</h2>
            <p>Everyone’s welcome — beginners especially.</p>
            <ul>
              <li>We meet on the <strong>third Thursday</strong> of the month, <strong>1–4pm</strong></li>
              <li>The Village Hall, Broome, near Bungay <a href="#where-we-meet">(directions)</a></li>
              <li>Visitors £3.50 — just come along</li>
            </ul>
          </section>
          */}
        </div>
      </div>

      <div class="static-info">
        {staticSections.map((s) => (
          <section class:list={["panel", { wide: s.wide }]} id={s.id} aria-labelledby={`${s.id}-title`}>
            <h2 class="section-head" id={`${s.id}-title`}>{s.heading}</h2>
            <PortableText portableText={s.body} />
            <a class="to-top" href="#top">↑ Back to top</a>
          </section>
        ))}
      </div>
    </div>
  </div>
</BaseLayout>

<style lang="scss">
  @use "../../styles/_breakpoints.scss" as *;

  /* ================================================================
     v2 design tokens — the whole preview is tuned from this block.
     ================================================================ */
  .v2 {
    /* type */
    --v2-body: "Andika", system-ui, sans-serif;
    --v2-display: "Delius Swash Caps", cursive;
    --v2-body-size: 1.05rem;
    --v2-body-leading: 1.6;

    /* colour */
    --v2-ink: #24313d;
    --v2-ink-soft: #4a5a68;
    --v2-navy: #0a335b;
    --v2-accent: #a63a00; /* madder */
    --v2-link: #0f5aa8;
    --v2-border: #c8eaff;
    --v2-panel: #e4f5ff;
    --v2-visit-bg: #ffffff; /* "New here?" card — deliberately distinct from --v2-panel */

    /* surface */
    --v2-texture: url("/images/noise.webp");
    --v2-radius: 6px 12px 8px 10px;
    --v2-shadow: 2px 4px 12px rgba(10, 51, 91, 0.12);

    font-family: var(--v2-body);
    font-size: var(--v2-body-size);
    line-height: var(--v2-body-leading);
    color: var(--v2-ink);

    :global(.portable-text p),
    :global(.portable-text li) {
      font-size: var(--v2-body-size);
      line-height: var(--v2-body-leading);
    }
    :global(.portable-text h3) { font-size: 1.15rem; }
    :global(.portable-text h4) { font-size: 1rem; }
    :global(.portable-text a),
    a {
      color: var(--v2-link);
      text-decoration: underline;
      text-underline-offset: 2px;
    }
    :global(a:focus-visible),
    :global(button:focus-visible) {
      outline: 3px solid var(--v2-accent);
      outline-offset: 2px;
    }
  }

  /* anchor links glide instead of snapping (quick-links, back-to-top) */
  @media (prefers-reduced-motion: no-preference) {
    :global(html) {
      scroll-behavior: smooth;
    }
  }

  .container {
    max-width: 1100px;
    margin: 0 auto;
    padding: 0 1rem 3rem;
  }

  .panel {
    background-color: var(--v2-panel);
    background-image: var(--v2-texture);
    border: 3px dotted var(--v2-border);
    border-radius: var(--v2-radius);
    box-shadow: var(--v2-shadow);
    padding: 1.25rem 1.4rem;
  }

  .section-head {
    display: inline-block;
    font-family: var(--v2-display);
    font-weight: 400;
    font-size: 1.35rem;
    color: #fff;
    background: var(--v2-navy);
    padding: 0.25rem 1rem;
    border-radius: var(--v2-radius);
    transform: rotate(-1deg);
    margin-bottom: 0.9rem;
  }

  .quick-links {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.5rem;
    /* chips sit across the strip's pinked bottom edge to tie the two together */
    position: relative;
    z-index: 3;
    margin: -1.35rem 0 1.5rem;

    @media (min-width: $BREAKPOINT_SMALL) {
      justify-content: flex-start;
    }

    a {
      background: #fff;
      border: 2px dotted var(--v2-border);
      border-radius: 999px;
      padding: 0.35rem 0.9rem;
      text-decoration: none;
      color: var(--v2-navy);
      font-weight: 700;
      font-size: 0.92rem;
      box-shadow: 0 2px 6px rgba(10, 51, 91, 0.18);

      &:hover { background: #e9f5ff; }
    }
  }

  .columns {
    display: grid;
    gap: 1.25rem;
    grid-template-columns: 1fr;

    @media (min-width: $BREAKPOINT_SMALL) {
      grid-template-columns: 3fr 2fr;
      align-items: start;
    }
  }

  .side-col {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .news-item {
    padding: 1rem 0;
    border-bottom: 2px dotted var(--v2-border);

    &:last-of-type { border-bottom: none; padding-bottom: 0.25rem; }

    h3 { margin: 0.15rem 0 0.3rem; font-size: 1.25rem; line-height: 1.3; }
  }

  .event-row {
    display: flex;
    gap: 0.9rem;
    padding: 0.8rem 0;
    border-bottom: 2px dotted var(--v2-border);
    align-items: flex-start;

    &:last-of-type { border-bottom: none; }

    h3 { font-size: 1.15rem; line-height: 1.3; margin-bottom: 0.1rem; }
  }

  .event-row__body :global(.portable-text p) {
    font-size: 0.95rem;
    color: var(--v2-ink-soft);
  }

  .mini-cal {
    background: #fff;
    border: 1px solid #ccc;
    border-radius: 6px;
    box-shadow: 0px 3px 3px rgba(0, 0, 0, 0.2);
    transform: rotate(-1.5deg);
    text-align: center;
    min-width: 64px;
    padding: 0.25rem 0.45rem 0.4rem;
    flex-shrink: 0;
    display: flex;
    flex-direction: column;

    &__wd { font-size: 0.72rem; text-transform: uppercase; letter-spacing: 0.05em; color: var(--v2-ink-soft); }
    &__day { font-family: "Caveat Brush", cursive; font-size: 1.5rem; line-height: 1; color: var(--v2-accent); }
    &__mon { font-size: 0.72rem; font-weight: 700; color: var(--v2-navy); }
  }

  .read-more {
    display: inline-block;
    margin-top: 0.4rem;
    font-weight: 700;
  }

  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  .all-link {
    display: inline-block;
    margin-top: 0.75rem;
    font-weight: 700;
  }

  .visit-card {
    background-color: var(--v2-visit-bg);

    ul { padding-left: 1.2rem; margin: 0.5rem 0; }
  }

  .static-info {
    display: grid;
    gap: 1.25rem;
    margin-top: 2.25rem;
    grid-template-columns: 1fr;

    @media (min-width: $BREAKPOINT_SMALL) {
      grid-template-columns: 1fr 1fr;
      .wide { grid-column: 1 / -1; }
    }

    section { scroll-margin-top: 1rem; }
  }

  .to-top {
    font-size: 0.85rem;
    display: inline-block;
    margin-top: 0.6rem;
  }
</style>
